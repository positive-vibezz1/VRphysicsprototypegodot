; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Physics Shooter Sandbox"
run/main_scene="res://sandbox/range.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

BallisticsPool="*res://ballistics/ballistics.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]

common/physics_ticks_per_second=90
3d/physics_engine="Jolt Physics"
3d/default_linear_damp=0.0
jolt_physics_3d/limits/max_linear_velocity=1500.0
common/enable_object_picking=false

[rendering]

anti_aliasing/quality/msaa_3d=2
renderer/rendering_method="mobile"
rendering_device/driver.windows="vulkan"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
shaders/enabled=true
